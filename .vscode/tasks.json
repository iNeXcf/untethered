{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "untethered: Build",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/dev.sh", "build"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "untethered: Run",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/dev.sh", "run"],
      "problemMatcher": ["$gcc"]
    }
  ]
}
